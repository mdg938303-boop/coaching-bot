# Telegram BotFather থেকে পাওয়া টোকেন
BOT_TOKEN=123456789:AAExampleTokenHere

# Admin-দের Telegram numeric ID, কমা দিয়ে আলাদা (একাধিক Admin দেওয়া যাবে)
ADMIN_IDS=111111111,222222222

# Local/Test: SQLite (ডিফল্ট, কিছু না দিলেও চলবে)
# DATABASE_URL=sqlite+aiosqlite:///./coaching_bot.db

# Production: Neon/PostgreSQL (postgres:// বা postgresql:// দিলেও অটো কনভার্ট হবে)
# DATABASE_URL=postgresql://user:password@host/dbname

# শুধুমাত্র Render-এর মতো Webhook deployment-এর জন্য প্রয়োজন।
# খালি রাখলে বট local polling মোডে চলবে।
# WEBHOOK_BASE_URL=https://your-app-name.onrender.com

# PORT=8080

# ঐচ্ছিক: Low Attendance রিপোর্টের থ্রেশহোল্ড (%), ডিফল্ট 75
# LOW_ATTENDANCE_THRESHOLD=75

# ঐচ্ছিক: প্রতি মাসের কোন তারিখ(গুলো)-এ Fee Due Reminder পাঠানো হবে (কমা দিয়ে
# একাধিক দেওয়া যায়), ডিফল্ট 5
# FEE_REMINDER_DAYS=5,15,25

# ঐচ্ছিক: প্রতিদিন কোন সময়ে (24-ঘন্টা ফরম্যাট, সার্ভার timezone) Due Reminder
# চেক হবে, ডিফল্ট সকাল ১০টা
# FEE_REMINDER_HOUR=10
# FEE_REMINDER_MINUTE=0

# --- ঐচ্ছিক: Direct SMS নোটিফিকেশন (Absent/Fee Due হলে সরাসরি অভিভাবকের SIM-এ SMS) ---
# provider: "bulksmsbd" অথবা "alphasms"
# SMS_PROVIDER=bulksmsbd
# SMS_API_KEY=your_gateway_api_key
# SMS_SENDER_ID=your_approved_sender_id
# উপরের কী গুলো সেট করার পর বটে ঢুকে ⚙️ Settings মেনু থেকে SMS চালু করুন।
# SMS_ENABLED_DEFAULT=false
